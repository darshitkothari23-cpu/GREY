# GREY TRADING SYSTEM - ENVIRONMENT CONFIGURATION
#
# Instructions:
# 1. Copy this file: copy .env.example .env
# 2. Edit .env with your real credentials. Do NOT edit this example file.
# 3. Never commit .env to git. Only commit .env.example.
#
# Getting credentials:
# ANGEL ONE: Angel One account > Settings > Developer > API.
# TELEGRAM: @BotFather > /newbot, then get chat ID from getUpdates.
# VIX FALLBACK: Optional. Check India VIX at https://www.nseindia.com.
# LOGGING: DEBUG is verbose, INFO is normal, WARNING/ERROR are quieter.
# MODE: LAB = testing, SHADOW = live data/no trades, PAPER = simulated, LIVE = real trades.


# ANGEL ONE CREDENTIALS
# ━━━━━━━━━━━━━━━━━━━━━━━

# Angel One API Key | Source: Angel One dashboard | Required: Yes | Default: None
ANGEL_API_KEY=your_angel_api_key_here

# Angel One Client ID | Source: Angel One account | Required: Yes | Default: None
ANGEL_CLIENT_ID=your_angel_client_id_here

# Angel One 4-digit PIN | Source: Your Angel One login PIN | Required: Yes | Default: None
ANGEL_PIN=your_4_digit_pin_here

# TOTP secret for automatic 2FA | Source: Angel One 2FA setup | Required: Recommended | Default: None
ANGEL_TOTP_SECRET=your_totp_secret_here

# One-time TOTP fallback | Source: Authenticator app | Required: Only if no secret | Default: None
ANGEL_TOTP=your_current_totp_code_here

# NIFTY 50 spot token override | Source: Angel One scrip master | Required: No | Default: 99926000
ANGEL_NIFTY_SPOT_TOKEN=99926000

# India VIX token override | Source: Angel One scrip master | Required: No | Default: 99926017
ANGEL_INDIA_VIX_TOKEN=99926017

# Pause between SmartAPI calls | Source: Operator setting | Required: No | Default: 0.75
ANGEL_API_PAUSE_SECONDS=0.75


# TELEGRAM CONFIGURATION - 15-MIN EVALUATION REPORTS
# ━━━━━━━━━━━━━━━━━━━━━━━

# Enable 15-minute evaluation reports | Source: Operator setting | Required: No | Default: False
GREY_TELEGRAM_ENABLED=False

# Telegram bot token | Source: @BotFather | Required: Yes if Telegram enabled | Default: None
GREY_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID | Source: getUpdates URL | Required: Yes if Telegram enabled | Default: None
GREY_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram prefix | Source: Operator setting | Required: No | Default: GREY:
GREY_TELEGRAM_PREFIX=GREY:


# TELEGRAM LIVE REPORTER - 5-MIN REAL-TIME UPDATES
# ━━━━━━━━━━━━━━━━━━━━━━━

# Enable 5-minute live module-score reports | Source: Operator setting | Required: No | Default: False
GREY_TELEGRAM_LIVE_ENABLED=False

# Live report frequency in seconds | Source: Operator setting | Required: No | Default: 300
GREY_TELEGRAM_LIVE_FREQUENCY_SECONDS=300


# VIX DATA PROVIDER
# ━━━━━━━━━━━━━━━━━━━━━━━

# Fallback India VIX if NSE scrape/cache fails | Source: NSE website | Required: No | Default: None
GREY_FALLBACK_INDIA_VIX=your_fallback_india_vix_here

# Fallback previous VIX close | Source: NSE website/notes | Required: No | Default: None
GREY_FALLBACK_VIX_PREV_CLOSE=your_fallback_vix_prev_close_here

# VIX cache duration in seconds | Source: Operator setting | Required: No | Default: 300
GREY_VIX_CACHE_SECONDS=300


# PCR CALCULATOR
# ━━━━━━━━━━━━━━━━━━━━━━━

# PCR cache duration in seconds | Source: Operator setting | Required: No | Default: 900
GREY_PCR_CACHE_SECONDS=900


# OI TRACKER
# ━━━━━━━━━━━━━━━━━━━━━━━

# OI baseline file path | Source: Operator setting | Required: No | Default: data/live_cache/oi_baselines.json
GREY_OI_TRACKER_FILE=data/live_cache/oi_baselines.json


# LOGGING
# ━━━━━━━━━━━━━━━━━━━━━━━

# Log level | Source: Operator setting | Required: No | Default: INFO
GREY_LOG_LEVEL=INFO

# Log file path | Source: Operator setting | Required: No | Default: logs/grey.log
GREY_LOG_FILE=logs/grey.log


# DAILY EFFICACY REPORTS AND OPTIONAL EMAIL
# ━━━━━━━━━━━━━━━━━━━━━━━

# Signal log for daily efficacy reports | Source: GREY journal path | Required: No | Default: journals/grey/phase1_signals.jsonl
GREY_EFFICACY_SIGNAL_LOG=journals/grey/phase1_signals.jsonl

# OHLCV CSV path for daily efficacy reports | Source: Your market data export | Required: No | Default: nifty_candles.csv
GREY_EFFICACY_OHLCV_PATH=nifty_candles.csv

# Daily report output folder | Source: Operator setting | Required: No | Default: daily_reports
GREY_EFFICACY_REPORT_DIR=daily_reports

# Report symbol and optional date override | Source: Operator setting | Required: No | Default: NIFTY / latest candle date
GREY_EFFICACY_SYMBOL=NIFTY
GREY_EFFICACY_REPORT_DATE=

# Enable email for daily efficacy report | Source: Operator setting | Required: No | Default: False
GREY_EFFICACY_EMAIL_ENABLED=False

# SMTP email settings | Source: Your email provider | Required: Yes only if email enabled | Default: None/587/true
GREY_SMTP_HOST=your_smtp_host_here
GREY_SMTP_PORT=587
GREY_SMTP_USERNAME=your_smtp_username_here
GREY_SMTP_PASSWORD=your_smtp_password_here
GREY_SMTP_TLS=true
GREY_EMAIL_FROM=your_from_email_here
GREY_EMAIL_TO=your_to_email_here


# GREY 2.0 ENHANCED INTELLIGENCE LAYER
# -------------------------------

# Safe dummy mode for GREY 2.0 | Source: Operator setting | Required: No | Default: True
GREY2_DUMMY_MODE=True

# Run GREY 2.0 every interval instead of one cycle | Source: Operator setting | Required: No | Default: False
GREY2_LOOP=False

# GREY 2.0 loop interval in seconds | Source: Operator setting | Required: No | Default: 300
GREY2_INTERVAL_SECONDS=300

# Default GREY 2.0 symbol | Source: Operator setting | Required: No | Default: NIFTY
GREY2_SYMBOL=NIFTY

# Disable news aggregation | Source: Review remediation | Required: No | Default: True
GREY_DISABLE_NEWS=True

# Disable keyword sentiment analysis | Source: Review remediation | Required: No | Default: True
GREY_DISABLE_SENTIMENT=True

# News cache duration in seconds | Source: Archived setting | Required: No | Default: 300
GREY_NEWS_CACHE_SECONDS=300

# Optional JSON list of custom news feeds | Source: Operator setting | Required: No | Default: built-in feeds
GREY_NEWS_FEEDS_JSON=

# Enable Claude reasoning calls | Source: Operator setting | Required: No | Default: False
GREY_REASONING_ENABLED=False

# Anthropic API key for Claude reasoning | Source: Anthropic Console | Required: Only if reasoning enabled | Default: None
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model name | Source: Anthropic documentation | Required: No | Default: claude-3-5-sonnet-latest
GREY_CLAUDE_MODEL=claude-3-5-sonnet-latest

# GOOGLE GEMINI - AI REASONING
# -------------------------------

# Google Gemini API key | Source: https://ai.google.dev/ > Get API key | Required: Only if Gemini enabled | Default: None
GOOGLE_GEMINI_API_KEY=AIzaSyD_your_google_gemini_api_key_here

# Enable Gemini reasoning for GREY 2.0 market analysis | Source: Operator setting | Required: No | Default: False for baseline shadow mode
GREY_GEMINI_ENABLED=False

# How often to query Gemini | Source: Operator setting | Required: No | Default: 1
GREY_GEMINI_FREQUENCY=1

# Only query Gemini if technical confidence is below this | Source: Operator setting | Required: No | Default: 0.55
GREY_GEMINI_MIN_CONFIDENCE=0.55

# Max seconds to wait for Gemini response | Source: Operator setting | Required: No | Default: 5
GREY_GEMINI_TIMEOUT=5

# NIFTY option lot-size fallback | Source: NSE contract specification | Required: No | Default: 75
GREY_NIFTY_LOT_SIZE=75

# Options flow snapshot cache duration in seconds | Source: Operator setting | Required: No | Default: 60
GREY_OPTIONS_FLOW_CACHE_SECONDS=60

# Large execution threshold for microstructure alerts | Source: Operator setting | Required: No | Default: 5000
GREY_LARGE_ORDER_THRESHOLD_QTY=5000

# REVIEW REMEDIATION CONTROLS
# -------------------------------

# Enable risk manager for every enhanced signal | Source: Review remediation | Required: No | Default: True
GREY_RISK_MANAGER_ENABLED=True

# Account size for shadow/paper risk sizing | Source: Operator setting | Required: No | Default: 100000
GREY_ACCOUNT_SIZE=100000

# Maximum daily loss before recommendations are blocked | Source: Review remediation | Required: No | Default: 2%
GREY_RISK_MAX_DAILY_LOSS_PCT=0.02

# Run Gemini-on and Gemini-off signal variants in parallel for first month | Source: Review remediation | Required: No | Default: True during shadow mode
GREY_A_B_TEST_MODE=True

# Use predicted range fit as the primary evaluation label for Iron Condors | Source: Review remediation | Required: No | Default: True from week 2
GREY_USE_RANGE_BOUND_EVALUATION=True


# DEVELOPMENT / TESTING
# ━━━━━━━━━━━━━━━━━━━━━━━

# GREY operating mode | Source: Operator setting | Required: No | Default: LAB
GREY_MODE=LAB

# Shadow mode, live data with no execution | Source: Operator setting | Required: No | Default: True
GREY_SHADOW_MODE=True


# SECURITY NOTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# .env contains sensitive credentials.
# Never commit .env, never share it, and keep it local only.
# Use .env.example for repo sharing.
#
# If credentials leak:
# - Angel One: Regenerate API key immediately.
# - Telegram: Regenerate bot token with @BotFather.
# - Change PIN/passwords.
#
# Test .env works:
# python test_telegram_live_reporter.py
# Note: this test is dry-run unless Telegram sending is enabled in code/config.
